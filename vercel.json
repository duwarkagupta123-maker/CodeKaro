{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api/index.py?path=$1" },
    { "src": "/web/(.*)", "dest": "/$1" },
    { "src": "/(.*)", "status": 404, "dest": "/404.html" }
  ]
}
