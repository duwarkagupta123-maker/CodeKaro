# Firebase Configuration (managed via firebase-applet-config.json)
FIREBASE_API_KEY=

# Optional SMTP Configuration for Email OTP Delivery
# When omitted, OTP codes are returned in preview mode for instant testing in the UI
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CodeKaro <no-reply@codekaro.dev>"
